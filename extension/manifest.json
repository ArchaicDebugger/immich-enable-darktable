{
  "manifest_version": 3,
  "name": "Immich → darktable",
  "version": "1.0.0",
  "description": "Open the selected Immich photos in darktable on this machine.",
  "key": "",
  "permissions": ["nativeMessaging", "storage", "cookies", "scripting"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "Open selection in darktable" },
  "options_ui": { "page": "options.html", "open_in_tab": true },
  "commands": {
    "open-in-darktable": {
      "suggested_key": { "default": "Alt+Shift+D" },
      "description": "Open the selected Immich photos in darktable"
    }
  },
  "icons": { "128": "icon128.png", "48": "icon48.png", "16": "icon16.png" }
}
